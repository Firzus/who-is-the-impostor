DATABASE_URL=postgresql://postgres:postgres@localhost:5432/impostor

# Public site URL (no trailing slash). Required for production SEO: canonical, Open Graph og:url, JSON-LD.
# VITE_SITE_URL=http://localhost:3000
# Docker: pass the same as a build arg (see docker-compose.yml) so the image embeds the correct origin.

# Server-only: set to 1 to disable the periodic purge of lobbies older than the TTL.
# The scheduler also stays off when Vitest runs (VITEST=true, set automatically) or in the browser bundle.
# DISABLE_LOBBY_CLEANUP=1

# Server-only: seconds before a kicked player can rejoin the same lobby with the same name (default: 30).
# KICK_COOLDOWN_SECONDS=30
